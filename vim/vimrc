colorscheme catppuccin

" --- CLIPBOARD BEHAVIOR ---
" Strategy: Only 'y' goes to clipboard. 'd', 'c', and 'x' stay in Vim.
" We do this by mapping 'y' to specifically use the + register (system)
vnoremap y "+y

" --- MODERN ESSENTIALS ---
syntax on " Enable syntax highlighting
set number " Show line numbers
set mouse=a " Enable mouse support for scrolling/clicking
set tabstop=4 " Default when sleuth can't detect (install: see CLAUDE.md)
set shiftwidth=4
set softtabstop=4 " Backspace deletes a full indent, not one space
set expandtab " Use spaces instead of tabs
set autoindent " Keep indent level from previous line
set smartindent " Better auto-indenting for C-like languages
filetype plugin indent on " Per-language indent rules, required for sleuth
set backspace=indent,eol,start " Backspace works across indents and line breaks
set ignorecase " Case-insensitive search
set smartcase " ...unless search contains a capital letter
set incsearch " Search as you type
set hlsearch " Highlight search results
set termguicolors " Better color support for Ghostty
set noswapfile

" --- UI IMPROVEMENTS ---
set cursorline " Highlight the line the cursor is on
set wildmenu " Visual autocomplete for command menu
set laststatus=2 " Always show the status bar
set background=dark " Tell Vim you're using a dark terminal theme

" --- KEYS ---
" Clear search highlights with Enter
nnoremap <CR> :nohl<CR><CR>

" --- FZF ---
nnoremap <C-p> :Files<CR>
nnoremap <C-b> :Buffers<CR>
nnoremap <C-f> :Rg<CR>

" UNDO
set undofile
" Recommended: Set a specific directory for undo files
" This prevents 'filename~' files from cluttering every folder you work in
set undodir=~/.vim/undodir
